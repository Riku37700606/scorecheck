#!/usr/bin/env python3
import sys

def error(message):
    print(f"エラー: {message}", file=sys.stderr)
    sys.exit(1)

threshold = 60

if len(sys.argv) > 2:
    error("引数は合格基準の1つだけ指定してください")

if len(sys.argv) == 2:
    try:
        threshold = float(sys.argv[1])
    except ValueError:
        error("合格基準は数値で指定してください")

if not 0 <= threshold <= 100:
    error("合格基準は0〜100点で指定してください")

scores = []

for line in sys.stdin:
    try:
        score = float(line.strip())
    except ValueError:
        error("点数は数値で入力してください")

    if not 0 <= score <= 100:
        error("点数は0〜100点で入力してください")

    scores.append(score)

if len(scores) == 0:
    error("点数が入力されていません")

count = len(scores)
average = sum(scores) / count
highest = max(scores)
lowest = min(scores)

passed = 0

for score in scores:
    if score >= threshold:
        passed += 1

failed = count - passed
pass_rate = passed / count * 100

print(f"受験者数: {count}人")
print(f"平均点: {average:.1f}点")
print(f"最高点: {highest:.1f}点")
print(f"最低点: {lowest:.1f}点")
print(f"合格基準: {threshold:g}点")
print(f"合格者数: {passed}人")
print(f"不合格者数: {failed}人")
print(f"合格率: {pass_rate:.1f}%")

sys.exit(0)
